---
// Page shell shared by the Sapphire Labs sites: <head> (SEO, icons, CSP-
// friendly boot scripts), header with the site menu, language and theme
// switches, and the footer. Each site wraps it in a small layout of its own
// that passes its name, menu and strings.
//
// The language switch appears when `dict` is given; the theme menu unless
// themes={false}. A `footer` slot replaces the default footer links.
import I18nBoot from '../components/I18nBoot.astro';
import type { Dict } from '../i18n';
import themeBootUrl from '../boot/theme.js?url';
import faviconUrl from '../assets/favicon.ico?url';
import icon96 from '../assets/icon-96.png?url';
import appleTouch from '../assets/apple-touch-icon.png?url';
// Fonts are bundled and served from the site itself: no request to a font
// CDN, so visitors' IP addresses are not shared with a third party.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/nunito/500.css';
import '@fontsource/nunito/700.css';
import '@fontsource/nunito/800.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

export interface NavItem {
  href: string;
  /** i18n key of the label (sites with a language switch). */
  key?: string;
  /** English label, shown until the language is applied. */
  label: string;
}

interface Props {
  /** Name of the site, e.g. "Meeting Helpers". */
  siteName: string;
  /** All strings of the site (merged with uiStrings). Without it there is no language switch. */
  dict?: Dict;
  nav: NavItem[];
  /** English page title for search engines; the tab title follows titleKey. */
  title?: string;
  description: string;
  /** i18n key for the tab title, so it follows the chosen language. */
  titleKey?: string;
  ogImage?: string;
  /** Show the dark / light / kawaii theme menu (default true). Without it the site stays dark. */
  themes?: boolean;
}

const BRAND = 'Sapphire Labs';
const { siteName, dict, nav, title, description, titleKey, ogImage = 'https://sapphire-labs.dev/brand/og.jpg', themes = true } = Astro.props;
const fullTitle = title ? `${title} · ${BRAND}` : siteName === BRAND ? BRAND : `${siteName} · ${BRAND}`;
const siteLabel = siteName === BRAND ? BRAND : `${siteName} · ${BRAND}`;
const hasFooter = Astro.slots.has('footer');
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href.startsWith('/') && href !== '/' && (path === href || path.startsWith(`${href}/`));
---

<!doctype html>
<html lang="en" class="sapphire-theme">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {themes && (
      <Fragment>
        <!-- Apply the saved theme before anything paints. -->
        <script is:inline src={themeBootUrl}></script>
      </Fragment>
    )}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={faviconUrl} sizes="any" />
    <link rel="icon" type="image/png" sizes="96x96" href={icon96} />
    <link rel="apple-touch-icon" href={appleTouch} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={siteLabel} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0d12" />
    <slot name="head" />
  </head>
  <body data-title-key={dict ? titleKey : undefined}>
    <div class="glow" aria-hidden="true"></div>

    <header class="nav wrap" data-chrome>
      <a class="brand" href="/" aria-label={siteName}>
        <img src={icon96} alt="" width="30" height="30" />
        <span class="wordmark">Sapphire <b>Labs</b></span>
      </a>
      <nav>
        {nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} data-i18n={dict ? item.key : undefined}>{item.label}</a>
        ))}
        {(dict || themes) && (
        <span class="tools">
          {dict && (
          <span class="lang" role="group" aria-label="Idioma / Language">
            <button type="button" data-set-lang="pt" lang="pt-BR" title="Português">PT</button>
            <button type="button" data-set-lang="en" lang="en" title="English">EN</button>
          </span>
          )}
          {themes && (
          <span class="theme" data-theme-menu>
            <button type="button" class="theme-btn" data-theme-toggle aria-haspopup="true" aria-expanded="false" data-i18n-title="theme.label" title="Theme">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.8 1.8-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.8 1.8-1.8H17a4 4 0 0 0 4-4c0-4.4-4-8-9-8z" />
                <circle cx="7.5" cy="11" r="1.2" fill="currentColor" /><circle cx="10.5" cy="7.5" r="1.2" fill="currentColor" /><circle cx="15" cy="7.5" r="1.2" fill="currentColor" />
              </svg>
            </button>
            <span class="theme-pop" role="menu" hidden>
              <button type="button" role="menuitemradio" aria-checked="true" data-set-theme="dark"><i class="sw sw-dark"></i><span data-i18n="theme.dark">Dark</span></button>
              <button type="button" role="menuitemradio" aria-checked="false" data-set-theme="light"><i class="sw sw-light"></i><span data-i18n="theme.light">Light</span></button>
              <button type="button" role="menuitemradio" aria-checked="false" data-set-theme="kawaii"><i class="sw sw-kawaii"></i><span data-i18n="theme.kawaii">Kawaii pink</span></button>
            </span>
          </span>
          )}
        </span>
        )}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap" data-chrome>
      <span>© {new Date().getFullYear()} {BRAND}</span>
      <span class="links">
        {hasFooter ? <slot name="footer" /> : (
          <Fragment>
            <span data-i18n="footer.local">No login. Your data stays in this browser.</span>
            <a href="https://sapphire-labs.dev">sapphire-labs.dev</a>
          </Fragment>
        )}
      </span>
    </footer>

    {dict && <I18nBoot dict={dict} />}
    <script>
      // Both are no-ops on pages without a language switch or theme menu.
      import { initI18n } from '../i18n';
      import { initThemeMenu } from '../client/theme';
      if (document.getElementById('i18n-dict')) initI18n();
      initThemeMenu();
    </script>
  </body>
</html>

<style>
  .glow {
    position: absolute; inset: 0 0 auto 0; height: 760px; pointer-events: none; z-index: -1;
    background: radial-gradient(560px 400px at 26% 34%, var(--glow), transparent 70%);
  }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 22px; padding-bottom: 22px; }
  .brand { display: flex; align-items: center; gap: 12px; color: var(--text); text-decoration: none; flex: none; }
  .wordmark { font-weight: 700; font-size: 1.12rem; letter-spacing: -0.01em; display: inline-flex; align-items: baseline; gap: 10px; }
  .wordmark b { font-weight: 500; font-size: 0.72rem; letter-spacing: 0.32em; text-transform: uppercase; color: var(--accent); }
  nav { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; justify-content: flex-end; }
  nav a { position: relative; color: var(--muted); text-decoration: none; font-size: 0.95rem; padding: 4px 0; }
  nav a:hover { color: var(--text); }
  /* Current page: brighter text plus an accent underline. */
  nav a[aria-current='page'] { color: var(--text); }
  nav a[aria-current='page']::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -3px; height: 2px; border-radius: 2px; background: var(--accent);
  }
  .tools { display: inline-flex; align-items: center; gap: 8px; }

  .lang { display: inline-flex; border: 1px solid var(--border-strong); border-radius: 7px; overflow: hidden; }
  .lang button {
    font: inherit; font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); cursor: pointer;
    background: transparent; border: 0; padding: 3px 8px;
  }
  .lang button:hover { color: var(--text); }
  .lang button[aria-pressed='true'] { background: var(--chip); color: var(--text); }

  .theme { position: relative; display: inline-flex; }
  .theme-btn {
    width: 30px; height: 26px; display: grid; place-items: center; cursor: pointer; border-radius: 7px;
    background: transparent; color: var(--muted); border: 1px solid var(--border-strong);
  }
  .theme-btn:hover, .theme-btn[aria-expanded='true'] { color: var(--text); background: var(--chip); }
  .theme-pop {
    position: absolute; right: 0; top: calc(100% + 8px); z-index: 50; min-width: 170px; padding: 6px;
    display: flex; flex-direction: column; gap: 2px;
    background: var(--surface); border: 1px solid var(--border-strong); border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
  }
  .theme-pop button {
    display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; cursor: pointer;
    font: inherit; font-size: 0.9rem; color: var(--text); background: transparent; border: 0; border-radius: 7px; padding: 7px 10px;
  }
  .theme-pop button:hover, .theme-pop button:focus-visible { background: var(--chip); outline: none; }
  .theme-pop button[aria-checked='true']::after { content: '✓'; margin-left: auto; color: var(--accent); font-weight: 700; }
  .sw { width: 16px; height: 16px; border-radius: 50%; flex: none; border: 1px solid rgba(127, 127, 127, 0.35); }
  .sw-dark { background: linear-gradient(135deg, #0b0d12 50%, #2f63f0 50%); }
  .sw-light { background: linear-gradient(135deg, #ffffff 50%, #2f63f0 50%); }
  .sw-kawaii { background: linear-gradient(135deg, #fff0f6 50%, #ff6fae 50%); }

  footer {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;
    margin-top: 96px; padding-top: 28px; padding-bottom: 40px; border-top: 1px solid var(--border);
    color: var(--muted); font-size: 0.9rem;
  }
  footer .links { display: flex; gap: 18px; flex-wrap: wrap; }
  footer a { color: var(--muted); text-decoration: none; }
  footer a:hover { color: var(--text); }
  @media (max-width: 760px) {
    .nav { align-items: flex-start; }
    .wordmark { display: none; }
    nav { gap: 6px 14px; }
    nav a { font-size: 0.86rem; }
  }
</style>
